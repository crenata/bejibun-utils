{
    "name": "@bejibun/utils",
    "version": "0.1.30",
    "author": "Havea Crenata <havea.crenata@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Bejibun-Framework/bejibun-utils.git"
    },
    "main": "index.js",
    "module": "index.js",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "1.4.0",
        "@types/luxon": "^3.7.5",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "tsc-alias": "^1.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0"
    },
    "bugs": {
        "url": "https://github.com/Bejibun-Framework/bejibun-utils/issues"
    },
    "description": "Any utils for Bejibun Framework",
    "homepage": "https://github.com/Bejibun-Framework/bejibun-utils#readme",
    "keywords": [
        "bun",
        "bun framework",
        "utils",
        "bejibun",
        "typescript"
    ],
    "license": "MIT",
    "scripts": {
        "alias": "tsc-alias -p tsconfig.json",
        "types": "cp -rf src/types dist",
        "rsync": "rsync -a dist/ ./",
        "clean": "rm -rf dist",
        "format": "prettier --write src --log-level=silent",
        "eslint": "eslint src",
        "lint": "bun run format && bun run eslint",
        "test": "bun test tests/",
        "build": "bun run lint && tsc -p tsconfig.json && bun run types && bun run alias && bun run rsync && bun run clean",
        "deploy": "bun run build && bun publish --access public"
    },
    "type": "module",
    "types": "index.d.ts",
    "dependencies": {
        "@bejibun/logger": "^0.2.1",
        "luxon": "^3.7.2"
    }
}
